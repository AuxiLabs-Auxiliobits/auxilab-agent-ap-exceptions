# ============================================================
# Invoice Processing Agent — Environment Configuration
# ============================================================

# ---------------------------------------------------------------------------
# LLM Provider Selection
# Switch between Gemini (default) and Claude with a single variable.
# Valid values: "gemini" | "claude"
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Option A: Google Gemini (LLM_PROVIDER=gemini)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
# GEMINI_FLASH_MODEL=gemini-2.5-flash    # Used by the ADK root agent
# GEMINI_PRO_MODEL=gemini-2.5-pro        # Used by classifier, rule discovery, ALF

# ---------------------------------------------------------------------------
# Option B: Anthropic Claude (LLM_PROVIDER=claude)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model and token overrides
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Option C: Demo mode (no API key needed)
# All LLM calls return pre-canned realistic responses.
# ---------------------------------------------------------------------------
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Optional: Rate limiting (seconds between LLM calls)
# Default: 1.0 — increase if hitting quota limits
# ---------------------------------------------------------------------------
# API_CALL_DELAY_SECONDS=1.0
