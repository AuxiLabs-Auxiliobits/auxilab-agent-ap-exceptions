# Base URL of the AP Exception Handling Agent FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Default tenant id sent with every run upload.
VITE_TENANT_ID=default

# Clerk publishable key (Clerk Dashboard -> API keys -> React).
# Prefer putting the real key in .env.local (gitignored) for local dev.
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
