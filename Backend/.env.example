# Provider precedence: anthropic > gemini > mock.
# Set ONE of these to engage real AI. Leave both blank for deterministic
# offline mock mode (full pipeline still runs end-to-end).

# Preferred provider: Anthropic Claude.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=
DRAFT_MODEL=

# Concurrency
AI_MAX_CONCURRENCY=10
CLASSIFY_BATCH_SIZE=20
# Per-task wall-clock ceiling (seconds) for a single classify/draft AI call,
# so one hung provider response can't stall the whole run.
AI_TASK_TIMEOUT_SECONDS=45

# Deployment environment. Prefixes "prod"/"stag" are treated as protected: the
# app refuses to boot unless AUTH_ENABLED, CORS_ALLOW_ORIGINS, a durable
# RUN_STORE_BACKEND, and (for live comms) COMMS_ALLOWED_DOMAINS are set.
ENVIRONMENT=dev

# Output
ARTIFACT_DIR=./artifacts
# LOG_LEVEL must be one of DEBUG/INFO/WARNING/ERROR/CRITICAL (a typo fails fast).
LOG_LEVEL=INFO
# Seconds to wait for in-flight background runs to finish on shutdown (SIGTERM).
SHUTDOWN_DRAIN_SECONDS=30

# ----------------------------------------------------------------------
# API authentication (Clerk JWT)  — Tier-1 security
# ----------------------------------------------------------------------
# When true, every /v1/* route requires a valid Clerk session token
# (Authorization: Bearer ...). Leave false for local/dev.
AUTH_ENABLED=false
# Clerk issuer (Dashboard -> API keys -> "Show JWT public key" / Frontend API).
CLERK_ISSUER=
# Optional: override the JWKS URL (else derived from CLERK_ISSUER).
CLERK_JWKS_URL=
# Optional: enforce an audience/azp claim.
CLERK_AUDIENCE=
# RBAC fallback role for an authenticated caller whose token carries no
# recognizable role (no app-role claim, no mapped Clerk org role). A Clerk
# "org:admin" always maps to admin regardless of this. One of:
# admin, manager, clerk, controller, auditor, procurement.
# See app/api/roles.py for the role -> permission matrix.
AUTH_DEFAULT_ROLE=clerk

# Per-org integrations (Phase 2 — BYOK). When true, a run uses the caller org's
# own stored AI provider key/model (configured by its admin in the UI) instead
# of the platform env keys below. Default false = env is the only config.
PER_ORG_CONFIG_ENABLED=false
# Fernet key used to encrypt per-org integration secrets at rest. REQUIRED to
# store any integration secret. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENC_KEY=

# ---- Per-org OAuth apps (Phase 2c). Register these once; orgs authorize against
# them via Settings -> Integrations. All optional — leave blank to disable OAuth
# (orgs can still use SMTP password / Slack webhook). ----
# Google Cloud OAuth client (scope gmail.send). Redirect URI is a FRONTEND route.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Slack app (chat:write). Redirect URI is a FRONTEND route.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_DEFAULT_CHANNEL=

# ----------------------------------------------------------------------
# CORS / rate limiting / observability  — Tier-2 hardening
# ----------------------------------------------------------------------
# Production: exact frontend origin(s), comma-separated. Empty => permissive
# localhost regex for dev.
CORS_ALLOW_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=240/minute
# Error tracking (optional). Set the DSN to enable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Normalized enterprise persistence (SQLAlchemy). When true, each completed run
# is written to the normalized tables (exceptions, classifications, resolutions,
# communications, status_history, agent_executions, priorities, vendors) AND the
# run store uses this same database (see RUN_STORE_BACKEND below).
DB_PERSISTENCE_ENABLED=false
# IMPORTANT: use the +psycopg driver (psycopg 3 is the shipped driver). A bare
# "postgresql://" URL defaults to psycopg2 and fails with ModuleNotFoundError.
#   sqlite (dev):  sqlite+pysqlite:///./ap_agent.db
#   Supabase direct:  postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#   Supabase pooler (IPv4, recommended if direct hangs):
#       postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+pysqlite:///./ap_agent.db

# ----------------------------------------------------------------------
# Run store backend — the operational store the API reads/writes
# ----------------------------------------------------------------------
#   auto     — DB store when DB_PERSISTENCE_ENABLED (uses DATABASE_URL, the
#              recommended single-database setup); else Supabase REST when
#              SUPABASE_URL/KEY set; else in-memory.
#   db | supabase | memory — force a specific backend.
RUN_STORE_BACKEND=auto

# ----------------------------------------------------------------------
# Durable run-execution queue (recommended for production)
# ----------------------------------------------------------------------
# When true, an uploaded run's input is persisted to the run_jobs table and an
# in-process worker leases + executes it — so a run survives a restart, a
# crashed run is re-leased (lease TTL) and retried. Requires a DB (DATABASE_URL).
# When false (default), runs execute as fire-and-forget background tasks that do
# NOT survive a restart. Run multiple instances for more throughput — the DB
# lease keeps claiming safe across processes.
RUN_QUEUE_ENABLED=false
RUN_QUEUE_POLL_SECONDS=0.25
RUN_QUEUE_LEASE_SECONDS=300
RUN_QUEUE_CONCURRENCY=2
RUN_QUEUE_MAX_ATTEMPTS=3
# Exponential retry backoff base (seconds): a failed attempt is held un-claimable
# for base * 2**(attempt-1), capped at 5 min, so a fast-failing run doesn't burn
# all its attempts in a fraction of a second. 0 = retry immediately.
RUN_QUEUE_RETRY_BACKOFF_SECONDS=5

# ----------------------------------------------------------------------
# Supabase REST run store (ALTERNATIVE to DATABASE_URL — only if you want the
# run store to go through the Supabase REST API instead of a direct DB conn)
# ----------------------------------------------------------------------
# When both are set AND RUN_STORE_BACKEND selects supabase, runs persist to a
# Supabase `runs` table via PostgREST. Leave blank to use DATABASE_URL/in-memory.
# IMPORTANT: use the SERVICE_ROLE key here (server-side, bypasses RLS) —
# NOT the publishable/anon key. Dashboard -> Settings -> API -> service_role.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_RUNS_TABLE=runs

# ----------------------------------------------------------------------
# Outbound communications (Email + Slack)
# ----------------------------------------------------------------------
# Safety: when COMMS_DRYRUN=true (the default) the system writes .eml /
# .json files to artifacts/sent/{run_id}/ instead of hitting real
# providers. Flip to false only after you've tested with dry-run and
# confirmed the rendered messages are correct.
COMMS_DRYRUN=true
COMMS_SENT_DIR=./artifacts/sent

# Gmail SMTP — requires 2-Factor Auth + App Password.
#   1. Enable 2FA on your Gmail account.
#   2. https://myaccount.google.com/apppasswords → generate a 16-char password.
#   3. Paste it below (no spaces).
# Free Gmail: 100 external emails/day. Google Workspace: 2,000/day.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=

# Slack Incoming Webhook URL — pick a single channel (e.g. #ap-escalations).
#   1. https://api.slack.com/apps → Create New App → From scratch.
#   2. Activate Incoming Webhooks → Add new webhook → choose the channel.
#   3. Copy the URL below.
# When LEFT EMPTY, slack / finance_note channels fall back to email
# (sent to COMMS_FINANCE_CONTROLLER_MAILBOX with a "[Finance escalation]"
# subject prefix). Set this once you have a Slack app provisioned.
SLACK_WEBHOOK_URL=

# Default recipient for emails when no vendor master is configured. No longer
# defaulted to a hardcoded inbox — leave empty and the resolver will SKIP the
# send rather than route every vendor email to one address.
COMMS_TEST_RECIPIENT=
COMMS_AP_TEAM_MAILBOX=
# Where finance_note (controller escalation) emails go when Slack isn't
# configured. If empty, falls back to COMMS_AP_TEAM_MAILBOX.
COMMS_FINANCE_CONTROLLER_MAILBOX=

# ---- Public contact form + newsletter (landing page) ----
# Inbox that receives website "Contact us" + newsletter submissions. If empty,
# falls back to GMAIL_SMTP_USER, then COMMS_AP_TEAM_MAILBOX.
CONTACT_RECIPIENT=
# Contact mail only ever goes to your own inbox, so it SENDS by default
# (independent of COMMS_DRYRUN). Set true to log instead of send (dev).
CONTACT_DRYRUN=false
# Newsletter bulk send (platform marketing list). The POST /v1/newsletter endpoint
# is disabled unless this token is set; send with header X-Newsletter-Token.
# (Or use: python -m scripts.send_newsletter ...). Gmail has daily caps — for a
# real list use an ESP.
NEWSLETTER_ADMIN_TOKEN=
NEWSLETTER_MAX_PER_SEND=500
# Absolute base URL for unsubscribe links in emails (no trailing slash),
# e.g. https://app.example.com. Falls back to http://localhost:8000.
PUBLIC_BASE_URL=

# Vendor master CSV — maps vendor_name -> AR email so VENDOR_EMAIL drafts reach
# the real vendor contact instead of the test recipient. Columns (case-
# insensitive): vendor_name|vendor|name and email|vendor_email|ar_email. When
# set, an unknown vendor is REFUSED (not mis-delivered). Empty => test-recipient
# fallback. e.g. VENDOR_MASTER_PATH=./sample_data/vendor_master.csv
VENDOR_MASTER_PATH=

# Per-domain daily send cap (enforced — blocks live email to a domain once it
# hits this many sends in a UTC day; 0 = unlimited).
COMMS_PER_DOMAIN_DAILY_CAP=25
# Live-send safety allowlist: comma-separated recipient domains allowed for
# REAL (non-dry-run) sends. Empty => allow all. Set in prod, e.g.:
#   COMMS_ALLOWED_DOMAINS=retinex.ai,yourcompany.com
COMMS_ALLOWED_DOMAINS=

# Email rendering
COMMS_EMAIL_HTML_ENABLED=true
# Signature block appended to every outbound email (added at send time, not
# by the LLM — keeps it consistent).
COMMS_SIGNATURE_NAME=
COMMS_SIGNATURE_TEAM=
COMMS_SIGNATURE_COMPANY=
COMMS_SIGNATURE_DISCLAIMER=This message is confidential and intended for the addressee only. If received in error, please notify the sender and delete.
# Set true to add a small "Prepared by AP Exception Agent and reviewed by
# the AP team" line in the email footer (AI-disclosure transparency).
COMMS_DISCLOSE_AI_ASSISTANCE=false
