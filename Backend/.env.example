# =====================================================================
# AP Exception Handling Agent — configuration
# =====================================================================
# There are NO required keys. Copy this file to `.env` (or don't) and the
# tool runs end-to-end in deterministic, offline MOCK MODE.
#
#     cp .env.example .env      # optional
#     python cli.py examples/sample_exceptions.csv
#     python ui.py              # Gradio UI at http://localhost:7860 (gradio ui.py = hot reload)
#
# Every variable below is one the CLI / Gradio pipeline actually reads. The
# optional FastAPI server (app/api) has many more — auth, database, job queue,
# outbound email/Slack — documented in app/config.py, not here.
#
# NOTE: the Gradio UI's "Advanced Settings" panel can set the provider, key,
# and model live without a restart. Those live values are held in the server
# process only and are LOST on restart — this file is the persistent source of
# truth. "Reload .env" in that panel re-reads this file and discards them.
# ---------------------------------------------------------------------

# ---- AI provider (all OPTIONAL) -------------------------------------
# Leave every key blank for offline mock mode (the demo default).
#
# Pin one provider: anthropic | gemini | azure | mock. Blank => auto-detect by
# precedence (anthropic > gemini > azure > mock). Pin it when more than one key
# is configured, otherwise the higher-precedence one silently wins. A pinned
# provider that is missing its credentials falls back to mock (never to a
# different live provider). The Gradio UI sets this for you.
AI_PROVIDER=

# Preferred provider: Anthropic Claude.
ANTHROPIC_API_KEY=
# Model overrides (blank => defaults shown). Current ids:
# claude-opus-4-8 (most capable), claude-opus-4-7, claude-sonnet-5,
# claude-sonnet-4-6, claude-haiku-4-5 (fastest/cheapest).
CLASSIFY_MODEL=claude-opus-4-7
DRAFT_MODEL=claude-sonnet-4-6

# Fallback provider: Google Gemini.
GEMINI_API_KEY=
# Both default to Flash on purpose — gemini-2.5-pro has a 0 RPM free tier, so
# every request 429s. Only set Pro if you have a paid Gemini key.
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
GEMINI_DRAFT_MODEL=gemini-2.5-flash

# Fallback provider: Azure OpenAI (needs the endpoint too, not just a key).
# On Azure the "model" is your own deployment name, and one deployment serves
# both classify and draft.
AZURE_OPENAI_API_KEY=
AZURE_CHAT_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VERSION=2024-10-21

# ---- AI call tuning (OPTIONAL) --------------------------------------
# Parallel AI calls, retry count, and the per-call / per-task timeouts.
# AI_TASK_TIMEOUT_SECONDS bounds a single classify/draft so one hung response
# can't stall the whole run.
AI_MAX_CONCURRENCY=10
AI_MAX_RETRIES=4
AI_TIMEOUT_SECONDS=60
AI_TASK_TIMEOUT_SECONDS=45

# ---- Routing & rules (OPTIONAL) -------------------------------------
# These change the agent's OUTPUT, not just its performance.
#
# YAML policy driving every routing decision. First match wins; a catch-all
# rule is enforced at load time.
RULES_POLICY_PATH=app/rules/policies/default.yaml
# Hard materiality backstop: an invoice at/above this amount can NEVER
# auto-approve, whatever the policy says — it is routed to MANUAL_REVIEW and
# the override is recorded in the rule trace. Set 0 to trust the policy alone.
AUTO_APPROVE_MAX_AMOUNT=10000

# ---- Severity thresholds (OPTIONAL, deterministic) ------------------
# HIGH if amount > HIGH_AMOUNT or days outstanding > HIGH_DAYS;
# MEDIUM if amount >= MEDIUM_AMOUNT_MIN; otherwise LOW.
# The AI's own severity guess is kept only as severity_ai_suggested — these
# thresholds set the canonical value.
SEVERITY_HIGH_AMOUNT=25000
SEVERITY_HIGH_DAYS=30
SEVERITY_MEDIUM_AMOUNT_MIN=5000

# ---- Priority scoring (OPTIONAL) ------------------------------------
# Weights should sum to 1.0. Score = w_amount*amount + w_age*age
#   + w_severity*severity + w_path*resolution_path + w_conf*(1 - confidence)
W_AMOUNT=0.30
W_AGE=0.25
W_SEVERITY=0.25
W_PATH=0.15
W_CONF=0.05
# Bucket cutoffs: HIGH >= HIGH_THRESHOLD, MEDIUM >= MEDIUM_THRESHOLD, else LOW.
HIGH_THRESHOLD=0.70
MEDIUM_THRESHOLD=0.40

# ---- Vendor history (OPTIONAL — STATEFUL) ---------------------------
# When on, each run appends to a per-vendor reliability profile, and those
# profiles enrich the classifier prompt on SUBSEQUENT runs. This means two
# runs over the same CSV can differ. Set false for strictly reproducible runs.
VENDOR_HISTORY_ENABLED=true
VENDOR_PROFILES_PATH=artifacts/vendor_profiles.json

# ---- Output (OPTIONAL) ----------------------------------------------
# Where per-run artifacts (JSON snapshot + audit log) are written.
ARTIFACT_DIR=./artifacts
